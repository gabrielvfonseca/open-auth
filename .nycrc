{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/dist/**",
    "**/node_modules/**",
    "packages/typescript-config/**"
  ],
  "reporter": [
    "text",
    "lcov",
    "html"
  ],
  "temp-dir": "./.nyc_output",
  "report-dir": "./coverage"
}
