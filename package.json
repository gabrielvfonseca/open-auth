{
  "name": "@open-auth/root",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Gabriel Fonseca <https://github.com/gabrielvfonseca>",
  "packageManager": "bun@1.3.3",
  "homepage": "https://github.com/gabrielvfonseca/open-auth/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/open-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/open-auth.git",
    "directory": "packages/auth"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 64",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "check": "knip",
    "knip": "DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy knip",
    "spell": "cspell \"**\"",
    "spell:fix": "cspell \"**\" --fix",
    "type-check": "turbo run type-check",
    "coverage": "bun test --coverage --pass-with-no-tests ./packages ./internal",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "bump": "bumpp",
    "clean": "turbo run clean",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^2.29.8",
    "bumpp": "latest",
    "cspell": "latest",
    "husky": "latest",
    "knip": "latest",
    "prisma": "^7.2.0",
    "turbo": "latest",
    "typescript": "latest",
    "ultracite": "latest"
  },
  "keywords": [
    "authentication",
    "account-management",
    "email-verification",
    "open-auth"
  ],
  "engines": {
    "bun": ">=1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "internal/*"
  ],
  "dependencies": {
    "consola": "^3.4.2"
  }
}
