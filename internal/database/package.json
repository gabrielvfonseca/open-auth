{
  "name": "@open-auth/internal-database",
  "version": "0.0.1",
  "description": "The data access layer for Open-Auth, using Prisma for type-safe database interactions and migration management.",
  "keywords": [
    "database",
    "prisma",
    "postgresql",
    "orm",
    "open-auth"
  ],
  "homepage": "https://github.com/gabrielvfonseca/open-auth/tree/main/packages/database#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/open-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/open-auth.git",
    "directory": "packages/database"
  },
  "license": "MIT",
  "author": "Gabriel Fonseca <https://github.com/gabrielvfonseca>",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./keys": {
      "types": "./dist/src/keys.d.ts",
      "default": "./dist/src/keys.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:push": "bunx --bun prisma db push",
    "prisma:pull": "bunx --bun prisma db pull",
    "prisma:validate": "bunx --bun prisma validate",
    "prisma:seed": "bunx --bun prisma db seed",
    "clean": "git clean -xdf -- node_modules .cache dist"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@t3-oss/env-core": "^0.13.8",
    "pg": "^8.12.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@open-auth/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "22.15.21",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "typescript": "^5.8.3"
  }
}
