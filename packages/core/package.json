{
  "name": "@open-auth/core",
  "version": "0.1.0",
  "description": "The core foundational library for Open-Auth, providing utilities, validation, and error handling.",
  "keywords": [
    "core",
    "utils",
    "validation",
    "logic",
    "open-auth"
  ],
  "homepage": "https://github.com/gabrielvfonseca/open-auth/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/open-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/open-auth.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Gabriel Fonseca <https://github.com/gabrielvfonseca>",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.940.0",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/encoding": "^1.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@open-auth/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
