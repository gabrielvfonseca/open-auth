    "type-check": "tsc --noEmit",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "ioredis": "^5.9.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@open-auth/tsconfig": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/node": "22.15.21",
    "typescript": "^5.8.3"
  }
