{
  "name": "@open-auth/cache",
  "version": "0.0.1",
  "description": "High-performance caching layer for Open-Auth, built on Redis.",
  "keywords": [
    "cache",
    "redis",
    "performance",
    "open-auth"
  ],
  "homepage": "https://github.com/gabrielvfonseca/open-auth/tree/main/packages/cache#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/open-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/open-auth.git",
    "directory": "packages/cache"
  },
  "license": "MIT",
  "author": "Gabriel Fonseca <https://github.com/gabrielvfonseca>",
  "type": "module",
  "main": "dist/index.js",
