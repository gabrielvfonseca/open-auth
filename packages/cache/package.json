  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
