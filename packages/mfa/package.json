{
  "name": "@open-auth/mfa",
  "version": "0.1.0",
  "description": "Multi-Factor Authentication (MFA) service for Open-Auth, supporting TOTP and recovery codes.",
  "keywords": [
    "mfa",
    "2fa",
    "totp",
    "security",
    "open-auth"
  ],
  "homepage": "https://github.com/gabrielvfonseca/open-auth/tree/main/packages/mfa#readme",
  "bugs": {
    "url": "https://github.com/gabrielvfonseca/open-auth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvfonseca/open-auth.git",
    "directory": "packages/mfa"
  },
  "license": "MIT",
  "author": "Gabriel Fonseca <https://github.com/gabrielvfonseca>",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test --pass-with-no-tests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@open-auth/core": "workspace:*",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.0.0",
    "@t3-oss/env-core": "^0.11.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@open-auth/tsconfig": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  }
}
