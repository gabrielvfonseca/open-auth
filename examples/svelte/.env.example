# Database
DATABASE_URL="postgresql://user:password@localhost:5432/open_auth"

# Security
ENCRYPTION_KEY="your-encryption-key-base64"

# Email (Optional/Console provider by default)
EMAIL_PROVIDER="console"
AWS_REGION="us-east-1"
AWS_SES_FROM_EMAIL="noreply@example.com"
AWS_SES_FROM_NAME="open-auth"

# Turnstile (Optional)
TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# WebAuthn/Passkeys (Optional)
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="open-auth Svelte Example"
WEBAUTHN_ORIGIN="http://localhost:5173"
NEXT_PUBLIC_BASE_URL="http://localhost:5173"

# OAuth (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
